# ---- required: the only thing you must fill in
ANTHROPIC_API_KEY=

# ---- optional
# Router: GPT picks Haiku/Sonnet/Opus. Without it, Claude Haiku does the routing.
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-5-mini
# Which domain folder to run: shop | helpdesk
DOMAIN=shop
# Sign session cookies. Change it.
SESSION_SECRET=change-me-to-a-long-random-string
# Server-side refusal fallback for Sonnet/Opus (beta). Set to "off" to disable.
CLAUDE_FALLBACKS=default
# Override model ids if needed
# MODEL_HAIKU=claude-haiku-5-5
# MODEL_SONNET=claude-sonnet-5-5
# MODEL_OPUS=claude-opus-5-5
# DB passwords used by docker-compose (first start only)
# DB_PASSWORD=app_dev_pw
# AI_READER_PASSWORD=reader_dev_pw
# ROUTINES_ENABLED=true
# COOKIE_SECURE=true   # when served over https
